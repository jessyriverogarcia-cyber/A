# --- Supabase ---------------------------------------------------------------
# En local : `pnpm db:start` remplit .env.local automatiquement.
# En production : projet Supabase en région UE (eu-central-1 Francfort ou eu-west-3 Paris).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # serveur et scripts uniquement — jamais côté client

# URL publique de l'application (liens magiques, retours OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Démo -------------------------------------------------------------------
# Comptes de démonstration en un clic, scénario live et sonde de test. false en production.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=StratoFab-demo-2026

# --- Assistant IA (vide = mode simulé, annoncé comme tel) ----------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Messagerie de l'entreprise (vide = envoi simulé) -------------------------
# Clé de chiffrement des jetons OAuth, 32 caractères minimum : `openssl rand -base64 48`
INTEGRATIONS_SECRET=
# Microsoft 365 : inscription d'application Entra ID, URL de retour
#   <NEXT_PUBLIC_SITE_URL>/settings/integrations/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
# Google Workspace : identifiant OAuth « application Web », URL de retour
#   <NEXT_PUBLIC_SITE_URL>/settings/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Connexion SSO (Supabase Auth) -------------------------------------------
# Fournisseurs activés dans Supabase (Authentication › Providers) : azure, google (séparés par des virgules).
# Vide : boutons affichés « Non configuré ». Seuls les comptes invités (profil existant) ont accès.
NEXT_PUBLIC_SSO_PROVIDERS=

# --- Tâches planifiées ---------------------------------------------------------
# Secret des appels planifiés (/jobs/inbox : relève des e-mails entrants), 16 caractères minimum.
CRON_SECRET=
