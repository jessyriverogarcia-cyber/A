# --- Supabase ---------------------------------------------------------------
# En local : `pnpm db:start` remplit .env.local automatiquement.
# En production : projet Supabase en région eu-central-2 (Zurich) ou eu-central-1 (Francfort).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # serveur et scripts uniquement — jamais côté client

# URL publique de l'application (redirections des liens magiques et du SSO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Démo -------------------------------------------------------------------
# Affiche les comptes de démonstration en un clic sur la page de connexion. false en production.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=StratoFab-demo-2026

# --- Intégrations (phase 4) — vides = mode simulé ------------------------------
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
